---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getProjects } from "../../data/projects";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

function getLocalizedPath(path: string) {
  const cleanPath = path.startsWith("/") ? path : `/${path}`;
  if (lang === "es") return `/es${cleanPath}`;
  return cleanPath;
}

const projects = getProjects(t, getLocalizedPath);
const plain = {
  glidocs: t("home.work.glidocs"),
  bullseye: t("home.work.bullseye"),
  "5star": t("home.work.5star"),
  casamezcal: t("home.work.casamezcal"),
} as Record<string, string>;
// ?ref=<project id> on links from client sites → personal greeting
const refs = Object.fromEntries(projects.map((p) => [p.id, p.title]));

const services = [
  {
    t: t("home.s1.t"),
    d: t("home.s1.d"),
    icon: "M3 8h18M7 5.5h.01M10 5.5h.01M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z",
  },
  {
    t: t("home.s2.t"),
    d: t("home.s2.d"),
    icon: "M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3ZM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z",
  },
  {
    t: t("home.s3.t"),
    d: t("home.s3.d"),
    icon: "M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2ZM10.5 18.5h3",
  },
];
const steps = [1, 2, 3].map((n) => ({
  n,
  t: t(`home.step${n}.t` as "home.step1.t"),
  d: t(`home.step${n}.d` as "home.step1.d"),
}));
const contact = getLocalizedPath("/contact");
---

<main class="home">
  <!-- ============ hero ============ -->
  <section class="hero">
    <p
      class="hello glass"
      id="hello"
      data-tpl={t("home.ref")}
      data-refs={JSON.stringify(refs)}
    >
      <span class="blip"></span><span class="txt">{t("footer.status")}</span>
    </p>

    <!-- same box as the fixed orb, so the greeting sits inside it -->
    <div class="stage">
      <h1>
        <span class="line" style="--i:0">{t("home.hero.a")}</span>
        <span class="line" style="--i:1">{t("home.hero.b")}</span>
      </h1>
    </div>

    <p class="sub rise" style="--i:3">{t("home.sub")}</p>
    <div class="cta rise" style="--i:4" id="herocta">
      <a class="btn big glow" href={contact}>{t("home.cta.primary")}</a>
      <a class="more" href="#work">{t("home.cta.secondary")} <span>↓</span></a>
    </div>
  </section>

  <!-- ============ services ============ -->
  <section class="block">
    <h2 class="reveal">{t("home.services.title")}</h2>
    <div class="cards">
      {
        services.map((s, i) => (
          <article class="card glass reveal" style={`--i:${i}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={s.icon} />
            </svg>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ work ============ -->
  <section class="block" id="work">
    <h2 class="reveal">{t("home.work.title")}</h2>
    <p class="blocksub reveal">{t("home.work.sub")}</p>
    <div class="track">
      {
        projects.map((p, i) => (
          <a class="shot glass reveal" style={`--i:${i}`} href={p.href}>
            <div class="win">
              <div class="winbar">
                <i /><i /><i />
                {p.visit && <span>{p.visit.label}</span>}
              </div>
              {p.image && (
                <img src={p.image} alt="" loading="lazy" decoding="async" />
              )}
            </div>
            <h3>{p.title}</h3>
            <p>{plain[p.id]}</p>
            <span class="go">
              {t("home.work.view")} <b>→</b>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ how it works ============ -->
  <section class="block">
    <h2 class="reveal">{t("home.how.title")}</h2>
    <ol class="steps glass reveal">
      {
        steps.map((s) => (
          <li>
            <span class="n iris">{s.n}</span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============ final call ============ -->
  <section class="final glass reveal" id="final">
    <h2>
      {t("home.final.a")}<br /><span class="iris">{t("home.final.b")}</span>
    </h2>
    <a class="btn big glow" href={contact}>{t("home.cta.primary")}</a>
    <p>{t("home.final.sub")}</p>
  </section>
</main>

<!-- phone: the call to action follows you once the hero button is gone -->
<a class="dock btn big glow" href={contact} id="dock">{t("home.cta.primary")}</a>

<script>
  // personal greeting for visitors arriving from a client's site (?ref=bullseye)
  const hello = document.getElementById("hello");
  const ref = new URLSearchParams(location.search).get("ref") ?? "";
  const name = hello && JSON.parse(hello.dataset.refs || "{}")[ref];
  if (hello && name) {
    hello.querySelector(".txt")!.textContent = hello.dataset.tpl!.replace(
      "{name}",
      name,
    );
    hello.classList.add("from-ref");
  }

  // dock: visible while neither the hero button nor the final card is on screen
  const dock = document.getElementById("dock");
  const seen = new Set<Element>();
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) =>
      e.isIntersecting ? seen.add(e.target) : seen.delete(e.target),
    );
    dock?.classList.toggle("show", seen.size === 0);
  });
  ["herocta", "final"].forEach((id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
</script>

<style>
  .home {
    flex: 1;
  }
  h2 {
    font-size: clamp(2.1rem, 8.6vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
  }
  h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .block p,
  .final p {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--dim);
  }

  /* ---------- hero ---------- */
  .hero {
    /* nav takes 68px of flow; the stage must land exactly on the fixed orb */
    padding-top: calc(var(--orb-top) - 68px);
    min-height: calc(100svh - 68px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }
  .hello {
    position: absolute;
    top: 14px;
    left: 50%;
    translate: -50% 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 9px;
    max-width: 100%;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    animation: rise 1s var(--ease) 0.9s both;
  }
  .hello.from-ref {
    white-space: normal;
    text-align: left;
    font-size: 14px;
    width: max-content;
  }
  .stage {
    width: var(--orb-size);
    height: var(--orb-size);
    flex-shrink: 0;
    display: grid;
    place-items: center;
    container-type: inline-size;
  }
  h1 {
    font-size: 12.4cqw;
    line-height: 1.02;
    letter-spacing: -0.05em;
    font-weight: 700;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.7);
  }
  .line {
    display: block;
    animation: line-in 1.3s var(--ease) both;
    animation-delay: calc(0.5s + var(--i) * 0.16s);
  }
  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(0.5em);
      filter: blur(14px);
    }
  }
  .rise {
    animation: rise 1.1s var(--ease) both;
    animation-delay: calc(0.5s + var(--i) * 0.16s);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .sub {
    margin-top: 22px;
    max-width: 30ch;
    font-size: clamp(1.0625rem, 4.4vw, 1.3rem);
    line-height: 1.45;
    color: #d2d2d7;
    text-wrap: balance;
  }
  .cta {
    margin: 24px 0 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 22px;
  }
  .more {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    padding: 12px 4px;
  }
  .more span {
    display: inline-block;
    animation: nudge 1.8s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* ---------- content blocks ---------- */
  .block {
    padding-top: clamp(72px, 16vw, 130px);
    scroll-margin-top: 20px;
  }
  .block > h2 + .cards,
  .block > h2 + .steps {
    margin-top: 26px;
  }
  .blocksub {
    margin-top: 10px;
  }

  .cards {
    display: grid;
    gap: 14px;
  }
  .card {
    padding: 26px 24px 28px;
  }
  .card svg {
    width: 34px;
    height: 34px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 20px;
  }
  .card p {
    margin-top: 8px;
  }

  /* work: a swipeable row on phones */
  .track {
    margin: 26px calc(var(--pad) * -1) 0;
    padding: 4px var(--pad) 30px;
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .shot {
    flex: 0 0 84%;
    scroll-snap-align: center;
    padding: 12px 12px 22px;
    display: flex;
    flex-direction: column;
  }
  .win {
    border-radius: 18px;
    overflow: hidden;
    background: #0a0a0c;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .winbar {
    height: 30px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    font-size: 11px;
    color: var(--dimmer);
  }
  .winbar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }
  .winbar span {
    margin-left: auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .win img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    background: #111;
  }
  .shot h3 {
    margin: 18px 10px 0;
  }
  .shot p {
    margin: 6px 10px 0;
    font-size: 1rem;
  }
  .go {
    margin: 16px 10px 0;
    font-size: 15px;
    font-weight: 700;
  }
  .go b {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }
  .shot:hover .go b {
    transform: translateX(5px);
  }

  .steps {
    list-style: none;
    padding: 6px 24px;
  }
  .steps li {
    display: flex;
    gap: 18px;
    padding: 22px 0;
  }
  .steps li + li {
    border-top: 1px solid var(--line);
  }
  .steps .n {
    font-size: 2.6rem;
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.04em;
    width: 0.8em;
    flex-shrink: 0;
  }
  .steps p {
    margin-top: 6px;
  }

  .final {
    margin-top: clamp(72px, 16vw, 130px);
    padding: 44px 24px 36px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    border-radius: 36px;
  }
  .final p {
    margin-top: -8px;
    font-size: 0.9375rem;
  }

  /* ---------- dock (phones only) ---------- */
  .dock {
    position: fixed;
    z-index: 30;
    left: 50%;
    bottom: calc(16px + env(safe-area-inset-bottom));
    translate: -50% 0;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translateY(24px) scale(0.92);
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease),
      visibility 0.5s;
  }
  .dock.show {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (min-width: 760px) {
    .dock {
      display: none;
    }
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
    .track {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      overflow: visible;
    }
    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      padding: 10px 30px;
    }
    .steps li {
      flex-direction: column;
      padding: 26px 22px;
    }
    .steps li + li {
      border-top: none;
      border-left: 1px solid var(--line);
    }
    .final {
      padding: 72px 24px 60px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line,
    .rise,
    .hello,
    .more span {
      animation: none;
    }
  }
</style>
