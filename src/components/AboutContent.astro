---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

function getLocalizedPath(path: string) {
  const cleanPath = path.startsWith("/") ? path : `/${path}`;
  if (lang === "es") return `/es${cleanPath}`;
  return cleanPath;
}

const skills = [
  { h: "Frontend", items: ["React", "Next.js", "TypeScript", "Tailwind"] },
  { h: "Backend", items: ["NestJS", "Node.js", "PostgreSQL", "REST / GraphQL"] },
  { h: "Mobile", items: ["React Native", "Expo", "Push / OTA", "App Store / Play"] },
  { h: "Infra", items: ["Docker", "CI / CD", "AWS / Vercel", "Git"] },
];

// Certificates. Sorted by date (newest first) in code — add in any order.
// `path` is the Platzi URL segment (curso/…-course or ruta/…-ruta); the verify
// link is derived from it.
const platzi = (es: string, en: string, date: string, path: string) => ({
  es,
  en,
  issuer: "Platzi",
  date,
  url: `https://platzi.com/p/vmrbaez/${path}/diploma/detalle/`,
});
const certs = [
  platzi("Next.js Avanzado", "Advanced Next.js", "2026-05-08", "curso/11553-course"),
  platzi("Diseño y Desarrollo Frontend", "Frontend Design & Development", "2026-04-14", "ruta/30064-ruta"),
  platzi("Seguridad Web & API", "Web & API Security", "2026-04-14", "ruta/30078-ruta"),
  platzi("Herramientas de AI para Devs", "AI Tools for Devs", "2026-02-24", "curso/10959-course"),
  platzi("Programación con TypeScript", "Programming with TypeScript", "2025-12-21", "ruta/30069-ruta"),
  {
    es: "Nest: Desarrollo backend escalable con Node",
    en: "Nest: Scalable Backend Development with Node",
    issuer: "devTalles",
    date: "",
    url: "https://cursos.devtalles.com/certificates/ihfgbd5gjm",
  },
  {
    es: "Astro: El framework para sitios web orientados al contenido",
    en: "Astro: The Framework for Content-Driven Websites",
    issuer: "devTalles",
    date: "",
    url: "https://cursos.devtalles.com/certificates/cuxin5fqdw",
  },
].sort((a, b) => (a.date < b.date ? 1 : -1));
---

<main class="page">
  <div class="pagehead">
    <div class="kicker"><span class="ln"></span>{t("about.kicker")}</div>
    <h1 class="display"><span class="row">{t("nav.about")}</span></h1>
  </div>

  <section class="bio glass reveal">
    <p class="big" set:html={t("about.bigstate")} />
    <p>{t("about.bio.1")}</p>
  </section>

  <section class="sec">
    <h2 class="reveal">{t("about.toolkit")}</h2>
    <div class="skills">
      {
        skills.map((s, i) => (
          <div class="skill glass reveal" style={`--i:${i}`}>
            <h3>{s.h}</h3>
            <ul>
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="sec">
    <h2 class="reveal">{t("about.certs")}</h2>
    <ul class="certs">
      {
        certs.map((c) => (
          <li>
            <a class="cert glass reveal" href={c.url} target="_blank" rel="noopener">
              <span>
                <small>
                  {c.issuer}
                  {c.date && ` · ${c.date.slice(0, 4)}`}
                </small>
                <b>{lang === "es" ? c.es : c.en}</b>
              </span>
              <i>{t("about.certs.verify")} ↗</i>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="closing glass reveal">
    <h2>
      {t("about.closing.1")}<br /><span class="iris">{t("about.closing.2")}</span>
    </h2>
    <a class="btn big glow" href={getLocalizedPath("/contact")}>{t("nav.cta")}</a>
  </section>
</main>

<style>
  h2 {
    font-size: clamp(2rem, 8vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
  }
  .sec {
    padding-top: clamp(64px, 14vw, 110px);
  }
  .sec > h2 {
    margin-bottom: 22px;
  }
  .bio {
    padding: 28px 24px;
    max-width: 720px;
    display: grid;
    gap: 16px;
  }
  .bio p {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: #d2d2d7;
  }
  .bio .big {
    font-size: clamp(1.4rem, 5.6vw, 1.9rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    font-weight: 600;
    color: var(--ink);
  }
  .bio .big :global(em) {
    font-style: normal;
    color: var(--accent);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .skill {
    padding: 20px 18px;
    border-radius: 24px;
  }
  .skill h3 {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 12px;
  }
  .skill ul {
    list-style: none;
    display: grid;
    gap: 6px;
  }
  .skill li {
    font-size: 1rem;
    font-weight: 500;
  }

  .certs {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .cert {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 22px;
  }
  .cert small {
    display: block;
    font-size: 0.8125rem;
    color: var(--dim);
    margin-bottom: 3px;
  }
  .cert b {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .cert i {
    font-style: normal;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--dim);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .cert:hover i {
    color: var(--ink);
  }

  .closing {
    margin-top: clamp(64px, 14vw, 110px);
    padding: 44px 24px 40px;
    border-radius: 36px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  @media (min-width: 760px) {
    .skills {
      grid-template-columns: repeat(4, 1fr);
    }
    .certs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
