---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const channels = [
  { label: "GitHub", url: "https://github.com/vicctor-romero" },
  { label: "LinkedIn", url: "https://linkedin.com/in/vicctor-romero" },
  { label: "X", url: "https://twitter.com/vicctor_romero" },
];
---

<main class="page">
  <div class="pagehead">
    <div class="kicker"><span class="blip"></span>{t("contact.kicker")}</div>
    <h1 class="display">
      <span class="row">{t("contact.h1a")}</span>
      <span class="row stroked">{t("contact.h1b")}</span>
    </h1>
  </div>

  <section class="contact">
    <div class="intro">
      <p class="clead">{t("contact.lead")}</p>
      <p class="avail">{t("contact.avail")}</p>
    </div>

    <form id="cform" class="form glass reveal">
      <div class="field">
        <label for="f-name">{t("contact.form.name")}</label>
        <input
          id="f-name"
          type="text"
          name="name"
          autocomplete="name"
          placeholder={t("contact.ph.name")}
          required
        />
      </div>
      <div class="field">
        <label for="f-email">{t("contact.form.email")}</label>
        <input
          id="f-email"
          type="email"
          name="email"
          autocomplete="email"
          inputmode="email"
          placeholder={t("contact.ph.email")}
          required
        />
      </div>
      <div class="field">
        <label for="f-message">{t("contact.form.message")}</label>
        <textarea
          id="f-message"
          name="message"
          rows="5"
          placeholder={t("contact.ph.message")}
          required></textarea>
      </div>
      <!-- honeypot: hidden from humans; bots fill it and get silently dropped -->
      <div class="hp" aria-hidden="true">
        <label
          >Company<input
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
          /></label
        >
      </div>
      <button class="btn big glow send" type="submit">{t("contact.send")}</button>
      <p
        class="formnote"
        id="fnote"
        role="status"
        data-default={t("contact.note.default")}
        data-sending={t("contact.note.sending")}
        data-ok={t("contact.note.ok")}
        data-error={t("contact.note.error")}
      >
        {t("contact.note.default")}
      </p>
    </form>

    <div class="also">
      <p>{t("contact.also")}</p>
      <ul>
        {
          channels.map((c) => (
            <li>
              <a class="glass" href={c.url} target="_blank" rel="noopener">
                {c.label} <span>↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</main>

<script>
  const form = document.getElementById("cform") as HTMLFormElement | null;
  const note = document.getElementById("fnote");
  if (form && note) {
    const msg = (k: string) => note.dataset[k] || "";
    const startedAt = Date.now(); // time-trap: real users take a few seconds
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = {
        name: String(fd.get("name") || "").trim(),
        email: String(fd.get("email") || "").trim(),
        message: String(fd.get("message") || "").trim(),
        company: String(fd.get("company") || ""), // honeypot (should stay empty)
        elapsed: Date.now() - startedAt,
      };
      note.textContent = msg("sending");
      note.classList.remove("ok", "err");
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          note.textContent = msg("ok");
          note.classList.add("ok");
          form.reset();
        } else {
          note.textContent = msg("error");
          note.classList.add("err");
        }
      } catch {
        note.textContent = msg("error");
        note.classList.add("err");
      }
    });
  }
</script>

<style>
  .contact {
    display: grid;
    gap: 28px;
    padding-bottom: 20px;
  }
  .clead {
    font-size: clamp(1.0625rem, 4.4vw, 1.3rem);
    line-height: 1.5;
    color: #d2d2d7;
    max-width: 34ch;
  }
  .avail {
    margin-top: 14px;
    font-size: 0.9375rem;
    color: var(--dim);
  }

  .form {
    padding: 26px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .field label {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .field input,
  .field textarea {
    width: 100%;
    /* 16px+ so iOS does not zoom the page on focus */
    font: 500 17px/1.45 var(--font-display);
    color: var(--ink);
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--line2);
    border-radius: 16px;
    padding: 14px 16px;
    resize: vertical;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--dimmer);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--ink);
    background: rgba(0, 0, 0, 0.5);
  }
  .send {
    width: 100%;
    margin-top: 6px;
  }
  .formnote {
    text-align: center;
    font-size: 0.9375rem;
    color: var(--dim);
  }
  .formnote.ok {
    color: #30d158;
    font-weight: 600;
  }
  .formnote.err {
    color: #ff6b7d;
    font-weight: 600;
  }

  /* honeypot — kept in the layout flow but off-screen so bots still see it */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .also p {
    font-size: 0.9375rem;
    color: var(--dim);
    margin-bottom: 12px;
  }
  .also ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .also a {
    display: inline-flex;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .also a span {
    color: var(--dim);
  }

  @media (min-width: 860px) {
    .contact {
      grid-template-columns: 1fr 1fr;
      gap: 28px clamp(36px, 6vw, 88px);
      align-items: start;
    }
    .form {
      grid-column: 2;
      grid-row: 1 / span 2;
      padding: 34px 32px 30px;
    }
  }
</style>
