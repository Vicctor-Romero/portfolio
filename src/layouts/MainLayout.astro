---
import "../styles/global.css";
import Header from "../components/inicio/Header.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** home page: the orb sits centred behind the greeting */
  home?: boolean;
}

const {
  title = "Victor Romero — Websites & apps",
  description = "Victor Romero — I build websites and apps for businesses. Tell me your idea and I take care of the rest.",
  home = false,
} = Astro.props;
const url = "https://www.vicctor-romero.com";
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={url} />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/png"
      href="https://res.cloudinary.com/dqkckcvl0/image/upload/v1753825897/VR_afn6h2.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://res.cloudinary.com/dqkckcvl0/image/upload/v1753825897/VR_afn6h2.png"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <!-- content stays visible without JS; reveals only arm once this runs -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <title>{title}</title>
  </head>

  <body class:list={[home && "is-home"]}>
    <div class="orb" aria-hidden="true">
      <div class="orb-in">
        <i class="halo"></i><i class="core"></i><i class="ring"></i>
      </div>
    </div>

    <div class="shell">
      <Header />
      <slot />
      <slot name="footer"><Footer /></slot>
    </div>

    <script>
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      // the orb roams with the scroll: --sy = scroll in viewport-heights
      const orb = document.querySelector<HTMLElement>(".orb");
      if (orb && !reduce) {
        let queued = false;
        const set = () => {
          orb.style.setProperty(
            "--sy",
            (window.scrollY / window.innerHeight).toFixed(3),
          );
          queued = false;
        };
        window.addEventListener(
          "scroll",
          () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(set);
            }
          },
          { passive: true },
        );
        set();
      }

      // reveal on scroll
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
